# Supabase project URL used by the Next.js app and browser client.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon/public key. Do not put service-role keys in this file.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Public site origin used for canonical URLs, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense client ID (e.g. "ca-pub-xxxxxxxxxxxxxxxx").
# Leave blank in dev to show placeholder banners.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# AdSense ad-slot IDs per placement.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""
NEXT_PUBLIC_ADSENSE_SLOT_HOME_SIDEBAR=""
NEXT_PUBLIC_ADSENSE_SLOT_RANKING=""
